# Website (Next.js) settings. Copy to .env.local and fill in. Never commit .env.local.
# The API has its own file: server/.env.example → server/.env

# ── Carekar API (Express, in server/) ─────────────────────────
# Local: http://localhost:4000 · Live: the Render URL, e.g. https://carekar-api.onrender.com
API_URL=http://localhost:4000

# ── Supabase Auth: admin email logins (Project Settings → API) ──
# Without these, /admin uses the preview password below.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# "anon public" key (or the newer "publishable" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Preview admin login (only used while Supabase Auth isn't configured) ──
ADMIN_PASSWORD=change-me
# Must match ADMIN_TOKEN in server/.env
ADMIN_TOKEN=long-random-string

SITE_URL=https://carekar.in

# ── Phase 3 ───────────────────────────────────────────────────
NEXT_PUBLIC_CLARITY_ID=
