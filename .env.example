# Website (Next.js) settings. Copy to .env.local and fill in. Never commit .env.local.
# The API has its own file: server/.env.example → server/.env

# ── Carekar API (Express, in server/) ─────────────────────────
# Local: http://localhost:4000 · Live: the Render URL, e.g. https://carekar-api.onrender.com
API_URL=http://localhost:4000

# ── Admin login (/admin): one shared team password ────────────
# Required in production (no defaults there). Locally, empty = preview password "carekar-admin".
# At least 10 characters.
ADMIN_PASSWORD=
# Long random string, at least 24 characters. Must be identical to ADMIN_TOKEN in server/.env.
ADMIN_TOKEN=

SITE_URL=https://carekar.in

# ── Phase 3 ───────────────────────────────────────────────────
NEXT_PUBLIC_CLARITY_ID=
