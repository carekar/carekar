# Copy to server/.env and fill in. Never commit server/.env.
PORT=4000

# ── Database: Supabase Postgres through Prisma ──────────────
# Without DATABASE_URL the API stores everything in server/data/db.json (laptop preview only).
# Supabase → Connect → "Transaction pooler" URI (port 6543). Used by the API.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Supabase → Connect → "Session pooler" URI (port 5432). Used by Prisma migrations.
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Customer Google login (Firebase Auth) ───────────────────
# Booking ID tokens are checked against this Firebase project. No secret needed.
FIREBASE_PROJECT_ID=carekar-6ca30

# ── Admin login ───────────────────────────────────────────────
# Long random string, at least 24 characters. Must be identical to ADMIN_TOKEN on the website.
# Required in production; without it /api/admin is closed.
ADMIN_TOKEN=

# ── New-lead alerts on Telegram (optional) ────────────────────
# Create a bot with @BotFather, add it to the team group, then get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Used for the admin link inside alerts
SITE_URL=https://carekar.in

# ── Phase 3 ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
